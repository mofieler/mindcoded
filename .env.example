# PostgreSQL — spin up via Coolify (free, runs on your VPS)
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://mindcoded:yourpassword@localhost:5432/mindcoded

# Resend (https://resend.com) — free tier: 3,000 emails/month
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@mindcoded.studio

# App config
# Must be a mailbox that actually receives — this is where contact form
# submissions land. RESEND_FROM_EMAIL above is only the verified sender domain.
ADMIN_EMAIL=moritzfieler@icloud.com
SITE_URL=https://mindcoded.studio

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
